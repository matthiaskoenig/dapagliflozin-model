        </math>
      </assignmentRule>
      <assignmentRule name="dapagliflozin leaving the lumen" variable="absorption">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> f_absorption </ci>
            <ci> DAPABS_k </ci>
            <ci> Vlumen </ci>
            <ci> dap_lumen </ci>
          </apply>
        </math>
      </assignmentRule>
      <rateRule variable="PODOSE_dap">
